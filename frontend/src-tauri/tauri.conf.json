{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "课溯 · VeriLecture",
  "version": "0.3.0-alpha.4",
  "identifier": "app.verilecture.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "课溯 · VeriLecture", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 680, "resizable": true, "fullscreen": false }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] } }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "nsis": { "installMode": "currentUser" } }
  }
}
